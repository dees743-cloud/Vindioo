<ui:FluentWindow x:Class="Vindioo.FavoriteAlertWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Meldingen voor deze favoriet"
                 Height="560" Width="520"
                 MinHeight="420" MinWidth="460"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Uitleg" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zie NotifySettingsWindow: WPF-UI zet de achtergrond van een FluentWindow bij het
             laden zelf terug op de effen themakleur, dus het verloop staat als eigen vlak. -->
        <Border Grid.RowSpan="3" Background="{StaticResource AppBackgroundBrush}" />

        <ui:TitleBar Grid.Row="0" Title="Meldingen voor deze favoriet" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Over welke favoriet het gaat. Zonder dit is een los venster met twee
                     invulvelden niet thuis te brengen wanneer er drie openstaan. -->
                <TextBlock x:Name="TitelTekst" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock x:Name="BronTekst" Style="{StaticResource Uitleg}" Margin="0,0,0,14" />

                <!-- ==================== de veiling loopt af ==================== -->
                <Border x:Name="VeilingVak" Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Waarschuw me voor het einde" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Uitleg}"
                                   Text="Dit kost geen enkel verzoek aan de site: het werkt met de sluitingstijd die de app al kent, uit het zoekresultaat of uit een ronde Nakijken." />

                        <!-- De rijen worden in de code-behind gemaakt: het zijn er twee om te
                             beginnen, en je kan er tot tien. -->
                        <StackPanel x:Name="MomentenLijst" />

                        <ui:Button x:Name="ExtraKnop" Content="+" Click="Extra_Click"
                                   Appearance="Secondary" Padding="14,4" Margin="0,4,0,0"
                                   HorizontalAlignment="Left" ToolTip="Nog een moment erbij" />

                        <TextBlock x:Name="MomentenUitleg" Style="{StaticResource Uitleg}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Geen veiling: dan is er niets af te tellen, en dat hoort er te staan in
                     plaats van een leeg vak. -->
                <Border x:Name="GeenVeilingVak" Style="{StaticResource Section}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Waarschuw me voor het einde" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="GeenVeilingTekst" Style="{StaticResource Uitleg}" Margin="0" />
                    </StackPanel>
                </Border>

                <!-- ==================== waarheen ==================== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Stuur het via" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Uitleg}"
                                   Text="Waar de kanalen zelf op ingesteld staan - je mailserver, je Telegram-token - verandert hier niets aan. Dat staat één keer centraal, achter het tandwiel bij Meldingen en achtergrond." />

                        <CheckBox x:Name="TrayBox" Content="Ballon bij de klok" Margin="0,0,0,6" />
                        <CheckBox x:Name="TelegramBox" Content="Telegram" Margin="0,0,0,6" />
                        <CheckBox x:Name="MailBox" Content="E-mail" />

                        <TextBlock x:Name="KanaalWaarschuwing" Style="{StaticResource Uitleg}"
                                   Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource ScrimBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Annuleren" Click="Cancel_Click" Appearance="Secondary"
                           Padding="16,8" Margin="0,0,8,0" IsCancel="True" />
                <ui:Button Content="Bewaren" Click="Save_Click" Appearance="Primary" Padding="16,8" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
