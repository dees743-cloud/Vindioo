<ui:FluentWindow x:Class="Zentrix.LotPriceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Prijsindicatie per gelezen titel"
                 Height="840" Width="760"
                 MinHeight="480" MinWidth="600"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Uitleg" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Eén gelezen titel met wat ze ongeveer waard is. Klikken opent de gewone
             prijsindicatie voor die titel, met alle vergelijkingen eronder. -->
        <DataTemplate x:Key="TitelRij">
            <Border Background="Transparent" CornerRadius="8" Padding="10,7" Cursor="Hand"
                    MouseLeftButtonUp="Rij_Klik"
                    ToolTip="Klik om de vergelijkingen van deze titel te zien.">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Bedrag}" MinWidth="86" TextAlignment="Right"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <!-- Geen marktwaarde: dan mag het streepje niet even hard
                                         roepen als een bedrag. -->
                                    <DataTrigger Binding="{Binding Gevonden}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titel}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Onder}" Style="{StaticResource Uitleg}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WPF-UI zet de Background van een FluentWindow bij het laden zelf terug op de
             effen themakleur; daarom staat het verloop als eigen vlak achter de inhoud. -->
        <Border Grid.RowSpan="3" Background="{StaticResource AppBackgroundBrush}" />

        <ui:TitleBar Grid.Row="0" Title="Prijsindicatie per gelezen titel" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,10,20,0">
            <StackPanel>

                <!-- ==================== het zoekertje ==================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="104" Height="84" CornerRadius="8" Margin="0,0,14,0"
                                Background="{StaticResource SurfaceHoverBrush}">
                            <Border x:Name="OriginPhoto" CornerRadius="8" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="OriginTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="OriginPrice" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSubtleBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== wat er opgezocht wordt ==================== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Wat zit er in deze partij?" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="UitlegText" Style="{StaticResource Uitleg}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextSubtleBrush}" />

                            <ui:Button x:Name="RunButton" Grid.Column="1" Content="Opzoeken"
                                       Appearance="Primary" Click="RunButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== de titels, duurste eerst ==================== -->
                <Border x:Name="LijstBlok" Style="{StaticResource Section}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LijstKop" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="Titels" ItemTemplate="{StaticResource TitelRij}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="20,8,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,12,0"
                       Text="Vraagprijzen van vandaag, per gelezen titel apart opgezocht. Er staat geen totaal bij: één verkeerd gelezen naam kan dat helemaal scheeftrekken. Ongeveer vijf op de zes namen zijn juist gelezen, en niet elke naam is een los te koop voorwerp." />

            <ui:Button Grid.Column="1" Content="Sluiten" Appearance="Secondary" IsCancel="True"
                       Click="CloseButton_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
