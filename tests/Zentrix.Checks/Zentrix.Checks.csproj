<Project Sdk="Microsoft.NET.Sdk">

  <!-- Controles voor Zentrix, zonder testframework: een gewoon consoleprogramma dat OK of
       FOUT per controle toont. Zie Program.cs voor waarom het zo in elkaar zit.

       Het project verwijst NIET naar Zentrix.csproj en niet naar een gebouwde dll, maar
       compileert de broncode van Models, Sources en Services zelf mee. Zo test je altijd
       de code zoals ze nu op schijf staat, en botst het niet met Visual Studio: dit project
       heeft zijn eigen bin en obj. De vensters (XAML) zitten er niet in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Voor DispatcherTimer in SearchScheduler, en dezelfde globale usings als de app. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zentrix.Checks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\Sources\*.cs" Link="App\Sources\%(Filename)%(Extension)" />
    <!-- TrayIcon is het enige stuk WinForms; het hoort bij het scherm, niet bij de logica. -->
    <Compile Include="..\..\Services\*.cs" Exclude="..\..\Services\TrayIcon.cs"
             Link="App\Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dezelfde versies als Zentrix.csproj: die staan al in de lokale NuGet-cache. -->
    <PackageReference Include="AngleSharp" Version="1.8.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>
