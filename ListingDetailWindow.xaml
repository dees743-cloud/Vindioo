<ui:FluentWindow x:Class="Zentrix.ListingDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Zoekertje"
                 Height="900" Width="820"
                 MinHeight="460" MinWidth="520"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Het label van een regel in het blok met gegevens: steeds even breed, zodat
             de waarden eronder elkaar netjes uitlijnen. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
        </Style>

        <Style x:Key="Waarde" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Grid.Column" Value="1" />
        </Style>

        <!-- Eén miniatuur. Klikken zet hem in de grote foto eronder; het randje toont
             welke dat is.

             Een VIERKANT vakje met Stretch="Uniform", dus de hele foto past erin - anders dan
             op de kaarten in de resultatenlijst, waar UniformToFill bijsnijdt zodat alle
             kaarten er gelijk uitzien. Hier moet je aan een miniatuur kunnen zien wélke foto
             het is, en bij een staande foto in een liggend vakje zag je enkel een strook uit
             het midden. Vierkant, want dan blijft een staande én een liggende foto even groot
             in beeld. -->
        <DataTemplate x:Key="Miniatuur">
            <Border Width="88" Height="88" Margin="0,0,8,8" CornerRadius="8"
                    Background="{StaticResource SurfaceHoverBrush}"
                    BorderThickness="2" Cursor="Hand"
                    MouseLeftButtonUp="Miniatuur_Klik">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActief}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentOnDarkBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Image Source="{Binding Url}" Stretch="Uniform" Margin="2"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WPF-UI zet de Background van een FluentWindow bij het laden zelf terug op de
             effen themakleur; daarom staat het verloop als eigen vlak achter de inhoud. -->
        <Border Grid.RowSpan="3" Background="{StaticResource AppBackgroundBrush}" />

        <ui:TitleBar Grid.Row="0" Title="Zoekertje" />

        <!-- De foto krijgt de vrije ruimte (rij 2), zodat hij meegroeit wanneer je het
             venster groter maakt. Wat eronder staat heeft een vaste hoogte en zijn eigen
             schuifbalk: anders duwt een lange beschrijving de foto weg. -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== titel en prijs ==================== -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="2,0,2,4" />
                <TextBlock x:Name="SubText" FontSize="13" TextWrapping="Wrap" Margin="2,0,2,12"
                           Foreground="{StaticResource TextSubtleBrush}" />
            </StackPanel>

            <!-- ==================== de miniaturen ====================
                 Eén rij die opzij schuift, geen WrapPanel. Een advertentie met vijftien foto's
                 zou anders drie rijen hoog worden en de grote foto wegduwen - en een WrapPanel
                 zonder begrensde breedte breekt sowieso nooit af: die liep gewoon de vensterrand
                 uit, met de laatste foto half afgesneden.

                 Het wieltje staat IN diezelfde rij, achter de laatste foto, zodat het meeschuift
                 en je ziet waar het volgende verschijnt. -->
            <ScrollViewer Grid.Row="1" x:Name="ThumbScroll" Margin="0,0,0,2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ThumbScroll_MouseWheel">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="Thumbs" ItemTemplate="{StaticResource Miniatuur}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border x:Name="LoadingTile" Width="88" Height="88"
                            Margin="0,0,8,8" CornerRadius="8"
                            Background="{StaticResource SurfaceHoverBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource SurfaceBorderBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                             Foreground="{StaticResource AccentOnDarkBrush}" />
                            <TextBlock Text="foto's" FontSize="10" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSubtleBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== de grote foto ==================== -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="10"
                    Padding="6" Cursor="Hand" MouseLeftButtonUp="BigPhoto_Klik"
                    ToolTip="Klik om de foto schermvullend te bekijken">
                <Image x:Name="BigPhoto" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <TextBlock Grid.Row="3" x:Name="PhotoStatus" FontSize="12" Margin="2,8,2,10"
                       TextWrapping="Wrap" Foreground="{StaticResource TextSubtleBrush}" />

            <!-- ==================== wie, sinds wanneer, en de tekst ==================== -->
            <!-- De bovengrens staat op dít blok en niet op zijn rij. Een rij op Auto meet haar
                 kind met oneindige hoogte; de schuifbalk besluit dan dat hij niet nodig is, en
                 daarna knipt de rij de tekst gewoon af - precies wat er misging. Met MaxHeight
                 hier wordt de ScrollViewer wél begrensd gemeten. Hoeveel, zegt
                 VolgVensterhoogte: iets minder dan de helft van het venster, zodat een lange
                 beschrijving meegroeit maar de foto niet verdringt. -->
            <Border Grid.Row="4" x:Name="InfoBlock" Style="{StaticResource Section}" Margin="0,0,0,4">
                <ScrollViewer x:Name="InfoScroll" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <!-- Ruimte rechts voor de schuifbalk, anders staat hij op de tekst. -->
                    <StackPanel Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Verkoper" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="0" x:Name="SellerText" Style="{StaticResource Waarde}" />

                            <TextBlock Grid.Row="1" Text="Online sinds" Style="{StaticResource Label}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" x:Name="PostedText" Style="{StaticResource Waarde}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="Site" Style="{StaticResource Label}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" x:Name="SourceText" Style="{StaticResource Waarde}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="3" Text="Link" Style="{StaticResource Label}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" x:Name="UrlText" Style="{StaticResource Waarde}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </Grid>

                        <!-- De beschrijving staat er als selecteerbare tekst: er staat vaak een
                             typenummer of een maat in die je ergens anders wil plakken. Een
                             TextBox zonder rand leest als tekst maar laat selecteren toe. -->
                        <TextBlock x:Name="DescriptionHeader" Text="Beschrijving" Margin="0,14,0,4"
                                   FontSize="13" Foreground="{StaticResource TextSubtleBrush}"
                                   Visibility="Collapsed" />
                        <TextBox x:Name="DescriptionText" Visibility="Collapsed"
                                 IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                 FontSize="13" Padding="0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,8,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                       Foreground="{StaticResource TextSubtleBrush}" />

            <!-- Dezelfde twee vensters als de rechtsklik op een foto in de resultatenlijst. Ze
                 horen ook hier: dit venster is waar je een zoekertje bekijkt, en dan is "wat is
                 het waard" de eerstvolgende vraag. -->
            <ui:Button Grid.Column="1" x:Name="PriceButton" Content="Prijsindicatie" Appearance="Secondary"
                       Margin="0,0,8,0" Click="PriceButton_Click"
                       ToolTip="Wat is dit ongeveer waard? Vergelijkt de vraagprijzen van hetzelfde model op de sites die daarvoor aanstaan." />
            <ui:Button Grid.Column="2" x:Name="AiButton" Content="AI-controle" Appearance="Secondary"
                       Margin="0,0,8,0" Click="AiButton_Click"
                       ToolTip="Laat een model op je eigen grafische kaart lezen wat er op de foto's staat." />
            <ui:Button Grid.Column="3" x:Name="OpenButton" Content="Openen op de site" Appearance="Primary"
                       Margin="0,0,8,0" Click="OpenButton_Click" />
            <ui:Button Grid.Column="4" Content="Sluiten" Appearance="Secondary" IsCancel="True"
                       Click="CloseButton_Click" />
        </Grid>

        <!-- ==================== de foto schermvullend ====================
             Over het hele venster, dus maximaliseren geeft de foto op volle grootte. Klikken
             (of Esc) doet hem weer dicht. Geen apart venster: dan moet er een tweede plaats
             onderhouden worden die hetzelfde doet. -->
        <Grid x:Name="ZoomLayer" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#E6000000" Cursor="Hand" MouseLeftButtonUp="Zoom_Klik">
            <Image x:Name="ZoomPhoto" Stretch="Uniform" Margin="24"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="ZoomHint" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="0,0,0,14" FontSize="12" Foreground="#CCFFFFFF" />
        </Grid>
    </Grid>
</ui:FluentWindow>
